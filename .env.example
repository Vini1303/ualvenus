# Copie este arquivo para ".env" e preencha conforme necessário.
# O site funciona sem nenhuma dessas variáveis (modo manual de pagamento
# e estimativa de frete simplificada) — adicione quando estiver pronto.

PORT=3000

# --- Banco de dados (Postgres) ---
# No Render: crie um Postgres e cole aqui a "Internal Database URL".
DATABASE_URL=

# Token para o painel de pedidos (/api/admin). Use um texto longo e aleatório.
ADMIN_TOKEN=

# URL pública do site depois do deploy (usada nos links de retorno do
# Mercado Pago e no CORS). Em desenvolvimento pode deixar como está.
SITE_URL=http://localhost:3000

# --- Pagamento (Mercado Pago) ---
# Gere em https://www.mercadopago.com.br/developers/panel
# Sem isso, o checkout cria o pedido e mostra instruções de pagamento manual.
MP_ACCESS_TOKEN=

# --- Pagamento manual (enquanto não configurar o Mercado Pago) ---
# Se preencher, a tela de confirmação mostra sua chave Pix.
PIX_KEY=

# Horas para cancelar pedidos sem pagamento e devolver o estoque (padrão 2).
PAYMENT_TIMEOUT_HOURS=2
